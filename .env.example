# Database (SQLite locally; see README for PostgreSQL notes)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development
# Comma-separated CORS allow-list; falls back to CLIENT_URL when empty.
ALLOWED_ORIGINS="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="nurtalim_session"
# Use "none" only when the frontend and API are on different sites and both use HTTPS.
COOKIE_SAMESITE="lax"

# Seed admin credentials
ADMIN_EMAIL="admin@nurtalim.uz"
ADMIN_PASSWORD="NurTalim!2026"

# Optional Telegram notifications (server-side only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Rate limits
LOGIN_RATE_LIMIT_MAX=10
PUBLIC_POST_RATE_LIMIT_MAX=30

# Frontend build (only needed when the API is not served from the same origin)
# VITE_API_URL="https://api.example.com/api"
# VITE_UPLOADS_URL="https://api.example.com/uploads"
