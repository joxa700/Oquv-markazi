{
  "name": "nur-talim-learning-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Multilingual learning center website with admin panel",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "node scripts/generate-sitemap.js && vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:setup": "prisma migrate deploy && node server/prisma/seed.js",
    "db:seed": "node server/prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "sitemap": "node scripts/generate-sitemap.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "cross-env DATABASE_URL=file:./test.db prisma migrate reset --force --skip-seed && cross-env DATABASE_URL=file:./test.db vitest run --config vitest.api.config.js",
    "test:all": "npm run test && npm run test:api",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.jsx"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma",
    "seed": "node server/prisma/seed.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@prisma/client": "^6.2.1",
    "@reduxjs/toolkit": "^2.5.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "i18next": "^24.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5",
    "redux-persist": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
